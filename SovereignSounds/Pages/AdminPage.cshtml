@page
@model SovereignSounds.Pages.AdminPageModel
@{
    ViewData["Title"] = "Admin";

    static string Truncate(string? value, int maxLength = 30)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return value.Length <= maxLength
            ? value
            : $"{value[..maxLength]}…";
    }
}

<h1 class="mb-3 py-1">@ViewData["Title"]</h1>

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center gap-2"
                 role="button"
                 tabindex="0"
                 style="cursor: pointer;"
                 data-bs-toggle="collapse"
                 data-bs-target="#songsAdminCard"
                 aria-expanded="true"
                 aria-controls="songsAdminCard">
                <h2 class="h4 mb-0">Songs</h2>
                <span class="bi bi-chevron-down"></span>
            </div>
            <div id="songsAdminCard" class="collapse show">
                <div class="card-body">
                    @if (Model.Songs.Count == 0)
                    {
                        <p class="text-muted mb-0">No songs found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle music-table music-table-compact music-table-compact-songs">
                                <colgroup>
                                    <col class="col-primary" />
                                    <col class="col-secondary" />
                                    <col class="col-tertiary hide-below-md" />
                                    <col class="col-actions" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Artist</th>
                                        <th class="hide-below-md">Album</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Songs)
                                    {
                                        <tr>
                                            <td>@Truncate(item.Title, 40)</td>
                                            <td>@Truncate(item.Artist, 40)</td>
                                            <td class="hide-below-md">@Truncate(item.Album?.Title, 35)</td>
                                            <td class="text-center">
                                                <a asp-page="/Music/Songs/Details" asp-route-id="@item.Id" class="btn btn-sm btn-success me-1" title="Details">
                                                    <span class="bi bi-eye btn-icon"></span>
                                                </a>
                                                <a asp-page="/Music/Songs/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary admin-edit-btn me-1" title="Edit">
                                                    <span class="bi bi-pencil-square btn-icon"></span>
                                                </a>
                                                <a asp-page="/Music/Songs/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                                    <span class="bi bi-trash"></span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small">
                        Page @Model.SongsPageNumber of @Model.SongsTotalPages (@Model.SongsTotalItems items)
                    </div>
                    @if (Model.SongsTotalPages > 1)
                    {
                        Dictionary<string, string> SongPagingVariables(int songsPageNumber) => new()
                        {
                            ["songsPageNumber"] = songsPageNumber.ToString(),
                            ["albumsPageNumber"] = Model.AlbumsPageNumber.ToString(),
                            ["genresPageNumber"] = Model.GenresPageNumber.ToString()
                        };

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(SongPagingVariables(1))">
                                        <span class="bi bi-chevron-double-left"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(SongPagingVariables(Math.Max(1, Model.SongsPageNumber - 1)))">
                                        <span class="bi bi-chevron-left"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(SongPagingVariables(Math.Min(Model.SongsTotalPages, Model.SongsPageNumber + 1)))">
                                        <span class="bi bi-chevron-right"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(SongPagingVariables(Model.SongsTotalPages))">
                                        <span class="bi bi-chevron-double-right"></span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center gap-2"
                 role="button"
                 tabindex="0"
                 style="cursor: pointer;"
                 data-bs-toggle="collapse"
                 data-bs-target="#albumsAdminCard"
                 aria-expanded="true"
                 aria-controls="albumsAdminCard">
                <h2 class="h4 mb-0">Albums</h2>
                <span class="bi bi-chevron-down"></span>
            </div>
            <div id="albumsAdminCard" class="collapse show">
                <div class="card-body">
                    @if (Model.Albums.Count == 0)
                    {
                        <p class="text-muted mb-0">No albums found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle music-table music-table-compact music-table-compact-albums">
                                <colgroup>
                                    <col class="col-primary" />
                                    <col class="col-secondary" />
                                    <col class="col-tertiary hide-below-md" />
                                    <col class="col-actions" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Artist</th>
                                        <th class="hide-below-md text-center">Songs</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Albums)
                                    {
                                        <tr>
                                            <td>@Truncate(item.Title, 40)</td>
                                            <td>@Truncate(item.Artist, 40)</td>
                                            <td class="hide-below-md text-center">@item.SongCount</td>
                                            <td class="text-center">
                                                <a asp-page="/Music/Albums/Details" asp-route-id="@item.Id" class="btn btn-sm btn-success me-1" title="Details">
                                                    <span class="bi bi-eye btn-icon"></span>
                                                </a>
                                                <a asp-page="/Music/Albums/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary admin-edit-btn me-1" title="Edit">
                                                    <span class="bi bi-pencil-square btn-icon"></span>
                                                </a>
                                                <a asp-page="/Music/Albums/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                                    <span class="bi bi-trash"></span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small">
                        Page @Model.AlbumsPageNumber of @Model.AlbumsTotalPages (@Model.AlbumsTotalItems items)
                    </div>
                    @if (Model.AlbumsTotalPages > 1)
                    {
                        Dictionary<string, string> AlbumPagingVariables(int albumsPageNumber) => new()
                        {
                            ["songsPageNumber"] = Model.SongsPageNumber.ToString(),
                            ["albumsPageNumber"] = albumsPageNumber.ToString(),
                            ["genresPageNumber"] = Model.GenresPageNumber.ToString()
                        };

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(AlbumPagingVariables(1))">
                                        <span class="bi bi-chevron-double-left"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(AlbumPagingVariables(Math.Max(1, Model.AlbumsPageNumber - 1)))">
                                        <span class="bi bi-chevron-left"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(AlbumPagingVariables(Math.Min(Model.AlbumsTotalPages, Model.AlbumsPageNumber + 1)))">
                                        <span class="bi bi-chevron-right"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(AlbumPagingVariables(Model.AlbumsTotalPages))">
                                        <span class="bi bi-chevron-double-right"></span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center gap-2"
                 role="button"
                 tabindex="0"
                 style="cursor: pointer;"
                 data-bs-toggle="collapse"
                 data-bs-target="#genresAdminCard"
                 aria-expanded="true"
                 aria-controls="genresAdminCard">
                <h2 class="h4 mb-0">Genres</h2>
                <span class="bi bi-chevron-down"></span>
            </div>
            <div id="genresAdminCard" class="collapse show">
                <div class="card-body">
                    @if (Model.Genres.Count == 0)
                    {
                        <p class="text-muted mb-0">No genres found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle music-table music-table-compact">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Genres)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td class="text-end">
                                                <a asp-page="/Music/Genres/Details" asp-route-id="@item.Id" class="btn btn-sm btn-success me-1" title="Details">
                                                    <span class="bi bi-eye btn-icon"></span>
                                                </a>
                                                <a asp-page="/Music/Genres/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary admin-edit-btn me-1" title="Edit">
                                                    <span class="bi bi-pencil-square btn-icon"></span>
                                                </a>
                                                <a asp-page="/Music/Genres/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                                    <span class="bi bi-trash"></span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small">
                        Page @Model.GenresPageNumber of @Model.GenresTotalPages (@Model.GenresTotalItems items)
                    </div>
                    @if (Model.GenresTotalPages > 1)
                    {
                        Dictionary<string, string> GenrePagingVariables(int genresPageNumber) => new()
                        {
                            ["songsPageNumber"] = Model.SongsPageNumber.ToString(),
                            ["albumsPageNumber"] = Model.AlbumsPageNumber.ToString(),
                            ["genresPageNumber"] = genresPageNumber.ToString()
                        };

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(GenrePagingVariables(1))">
                                        <span class="bi bi-chevron-double-left"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(GenrePagingVariables(Math.Max(1, Model.GenresPageNumber - 1)))">
                                        <span class="bi bi-chevron-left"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(GenrePagingVariables(Math.Min(Model.GenresTotalPages, Model.GenresPageNumber + 1)))">
                                        <span class="bi bi-chevron-right"></span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-page="./AdminPage" asp-all-route-data="@(GenrePagingVariables(Model.GenresTotalPages))">
                                        <span class="bi bi-chevron-double-right"></span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
