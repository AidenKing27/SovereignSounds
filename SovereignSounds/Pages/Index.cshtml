@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center py-5">
    <h1 class="display-3 mb-4">Welcome to Sovereign Sounds</h1>
    <p class="lead text-muted">Your premier music-store destination for discovering and purchasing your favorite music, full albums, and individual songs.</p>
    <div>
        <a asp-page="/Music/Songs/View" class="btn btn-primary btn-lg mt-4">
            <span class="bi bi-music-note-list me-2 btn-icon"></span>
            View Songs
        </a>
    </div>
    <div>
        <a asp-page="/Music/Albums/View" class="btn btn-primary btn-lg mt-4">
            <span class="bi bi-music-note-list me-2 btn-icon"></span>
            View Albums
        </a>
    </div>
</div>

<div class="row">
    <div class="col">
        <div class="deco-img" style="rotate: -20deg; position: relative; top: -90px;"></div>
    </div>
    <div class="col">
        <div class="deco-img" style="rotate: 20deg; position: relative; top: -90px;"></div>
    </div>
</div>
