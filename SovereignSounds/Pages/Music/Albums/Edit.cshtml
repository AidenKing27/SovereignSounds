@page
@model SovereignSounds.Pages.Music.Albums.EditModel

@{
    ViewData["Title"] = "Edit Album";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <div class="card shadow">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0">Edit Album</h1>
                </div>
            </div>
            <div class="card-body p-4">
                <form id="editAlbumForm" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Album.Id" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Album.Title" class="form-control" aria-required="true" placeholder="title" />
                                <label asp-for="Album.Title"></label>
                            </div>
                            <span asp-validation-for="Album.Title" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Album.Artist" class="form-control" aria-required="true" placeholder="artist" />
                                <label asp-for="Album.Artist"></label>
                            </div>
                            <span asp-validation-for="Album.Artist" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Album.ReleaseDate" class="form-control" aria-required="true" placeholder="release date" />
                                <label asp-for="Album.ReleaseDate"></label>
                            </div>
                            <span asp-validation-for="Album.ReleaseDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Album.Price" class="form-control" aria-required="true" placeholder="0.00" />
                                <label asp-for="Album.Price"></label>
                            </div>
                            <span asp-validation-for="Album.Price" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Album.Picture" class="form-control" aria-required="true" placeholder="picture url" />
                                <label asp-for="Album.Picture"></label>
                            </div>
                            <span asp-validation-for="Album.Picture" class="text-danger"></span>
                        </div>
                    </div>

                </form>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <a asp-page="./View" class="btn btn-secondary mt-2 mb-2">
                        <span class="bi bi-arrow-return-left me-2"></span>
                        Back to List
                    </a>
                    <button type="submit" form="editAlbumForm" class="btn btn-primary mt-2 mb-2">
                        <span class="bi bi-check2 me-2 btn-icon"></span>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
