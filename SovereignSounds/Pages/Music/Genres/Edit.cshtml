@page
@model SovereignSounds.Pages.Music.Genres.EditModel

@{
    ViewData["Title"] = "Edit Genre";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0">Edit Genre</h1>
                </div>
            </div>
            <div class="card-body p-4">
                <form id="editGenreForm" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Genre.Id" />

                    <div class="form-floating">
                        <input asp-for="Genre.Name" class="form-control" aria-required="true" placeholder="genre name" />
                        <label asp-for="Genre.Name"></label>
                        <span asp-validation-for="Genre.Name" class="text-danger"></span>
                    </div>

                </form>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <a asp-page="./View" class="btn btn-secondary mt-2 mb-2">
                        <span class="bi bi-arrow-return-left me-2"></span>
                        Back to List
                    </a>
                    <button type="submit" form="editGenreForm" class="btn btn-primary mt-2 mb-2">
                        <span class="bi bi-check2 me-2 btn-icon"></span>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
