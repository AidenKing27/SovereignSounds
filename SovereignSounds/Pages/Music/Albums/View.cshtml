@page
@using SovereignSounds.Models
@model SovereignSounds.Pages.Music.Albums.ViewModel
@{
    ViewData["Title"] = "Albums";
}

<div class="card shadow">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
            <h1 class="mb-0">Albums</h1>
            <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                <form method="post" asp-page-handler="SetListStyle">
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="style" id="gridStyle"
                               value="@ListStyle.Grid.ToString()"
                               @(Model.ListStyle == ListStyle.Grid ? "checked" : "")
                               onchange="this.form.submit()" autocomplete="off">
                        <label class="btn btn-toggle" for="gridStyle">
                            <span class="bi bi-grid-3x3-gap-fill btn-icon"></span>
                        </label>

                        <input type="radio" class="btn-check" name="style" id="listStyle"
                               value="@ListStyle.List.ToString()"
                               @(Model.ListStyle == ListStyle.List ? "checked" : "")
                               onchange="this.form.submit()" autocomplete="off">
                        <label class="btn btn-toggle" for="listStyle">
                            <span class="bi bi-list-ul btn-icon"></span>
                        </label>
                    </div>
                </form>
                <a asp-page="Create" class="btn btn-primary">
                    <span class="bi bi-plus-lg btn-icon"></span>
                    Create New
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Album[0].Title)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Album[0].Artist)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Album[0].ReleaseDate)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.Album[0].Price)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.Album[0].Duration)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Album[0].Picture)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Album)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Artist)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ReleaseDateDisplay)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.Duration)
                            </td>
                            <td>
                                <img class="img-fluid" src="@item.Picture" alt="@item.Title" width="50" height="50" />
                            </td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <span class="bi bi-pencil-square"></span>
                                </a>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                    <span class="bi bi-info-circle"></span>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <span class="bi bi-trash"></span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
