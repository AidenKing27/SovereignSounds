@page
@model SovereignSounds.Pages.CheckoutModel
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = "Checkout";
    bool isAdmin = User.IsInRole("Admin");
    bool isAuthenticated = SignInManager.IsSignedIn(User);

    static string Truncate(string? value, int maxLength = 20)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Length <= maxLength
            ? value
            : $"{value[..maxLength]}…";
    }

    decimal cartTotal = 0;
    foreach (var item in Model.Cart)
    {
        cartTotal += item.Price;
    }
    decimal tax = cartTotal * 0.05m;
    decimal aidenCut = cartTotal * 0.50m;
    decimal grandTotal = cartTotal + tax + aidenCut;
}
<div class="row">
    <div class="col-lg-8 col-7">
        <div class="card shadow">
            <form method="post">
            <div class="card-header">
                <div class="p-2">
                    <h1 class="mb-0">Order Confirmation</h1>
                    <p class="mb-0">Please provide your information</p>
                </div>
            </div>
            <div class="card-body">
                    <div class="row">
                        <div class="col mb-3">
                            <div class="form-floating">
                                <input asp-for="Data.FirstName" class="form-control" placeholder="first name" />
                                <label asp-for="Data.FirstName" class="form-label"></label>
                            </div>
                            <span asp-validation-for="Data.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col mb-3">
                            <div class="form-floating">
                                <input asp-for="Data.LastName" class="form-control" placeholder="last name" />
                                <label asp-for="Data.LastName" class="form-label"></label>
                            </div>
                            <span asp-validation-for="Data.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col mb-3">
                            <div class="form-floating">
                                <input asp-for="Data.Phone" class="form-control" placeholder="(555) 555-5555" />
                                <label asp-for="Data.Phone" class="form-label"></label>
                            </div>
                            <span asp-validation-for="Data.Phone" class="text-danger"></span>
                        </div>
                        <div class="col mb-3">
                            <div class="form-floating">
                                <input asp-for="Data.Email" class="form-control" placeholder="name@example.com" />
                                <label asp-for="Data.Email" class="form-label"></label>
                            </div>
                            <span asp-validation-for="Data.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <div class="form-floating">
                            <input asp-for="Data.ShippingAddress" class="form-control" placeholder="123 fake st" />
                            <label asp-for="Data.ShippingAddress" class="form-label"></label>
                        </div>
                        <span asp-validation-for="Data.ShippingAddress" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            <input asp-for="Data.CreditCardNumber" class="form-control" placeholder="5555 5555 5555 5555" />
                            <label asp-for="Data.CreditCardNumber" class="form-label"></label>
                        </div>
                        <span asp-validation-for="Data.CreditCardNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            <input asp-for="Data.CreditCardName" class="form-control" placeholder="first last" />
                            <label asp-for="Data.CreditCardName" class="form-label"></label>
                        </div>
                        <span asp-validation-for="Data.CreditCardName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col mb-3">
                            <div class="form-floating">
                                <input asp-for="Data.ExpiryDate" class="form-control" placeholder="00/00" />
                                <label asp-for="Data.ExpiryDate" class="form-label"></label>
                            </div>
                            <span asp-validation-for="Data.ExpiryDate" class="text-danger"></span>
                        </div>
                        <div class="col mb-3">
                            <div class="form-floating">
                                <input asp-for="Data.CVV" class="form-control" placeholder="000" />
                                <label asp-for="Data.CVV" class="form-label"></label>
                            </div>
                            <span asp-validation-for="Data.CVV" class="text-danger"></span>
                        </div>
                    </div>
            </div>
            <div class="card-footer p-3">
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-danger" id="cancel" asp-page="/ShoppingCart">Cancel</a>
                        <button class="btn btn-primary" type="submit" id="submit">Place Order</button>
                    </div>
            </div>
            </form>
        </div>
    </div>
    <div class="col-lg-4 col-5">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <div>Order Summary</div>
                    <div class="small text-end">
                        Total Items - @Model.Cart.Count
                    </div>
                </div>
            </div>
            <div class="card-body checkout-font-size">

                
                <div class="row mb-0">
                    <div class="col-sm-9" style="font-size: 0.8em">Item</div>
                    <div class="col-sm-3 text-end" style="font-size: 0.8em">Price</div>
                </div>
                @foreach (var item in Model.Cart)
                {
                    <div class="row mb-1">
                        <div class="col-sm-9">@Truncate(item.Artist, 16) - @Truncate(item.Title, 20)</div>
                        <div class="col-sm-3 text-end">@Html.DisplayFor(modelItem => item.Price)</div>
                    </div>
                }
                <hr />
                <div class="row">
                    <div class="col-sm-9">Cart Total:</div>
                    <div class="col-sm-3 text-end">@cartTotal.ToString("C2")</div>
                </div>
                <div class="row">
                    <div class="col-sm-9">Tax:</div>
                    <div class="col-sm-3 text-end">@tax.ToString("C2")</div>
                </div>
                <div class="row">
                    <div class="col-sm-9">Aiden Cut (50%):</div>
                    <div class="col-sm-3 text-end">@aidenCut.ToString("C2")</div>
                </div>
                <div class="row">
                    <div class="col-sm-9">Grand Total:</div>
                    <div class="col-sm-3 text-end" style="font-weight: 600; font-size: 1.2em;">@grandTotal.ToString("C2")</div>
                </div>

            </div>
            <div class="card-footer text-end p-3">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
