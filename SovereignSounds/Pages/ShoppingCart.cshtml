@page
@model SovereignSounds.Pages.ShoppingCartModel
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = "Cart";
    bool isAdmin = User.IsInRole("Admin");
    bool isAuthenticated = SignInManager.IsSignedIn(User);

    static string Truncate(string? value, int maxLength = 20)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Length <= maxLength
            ? value
            : $"{value[..maxLength]}…";
    }

    decimal cartTotal = 0;
    foreach (var item in Model.Cart)
    {
        cartTotal += item.Price;
    }
    decimal tax = cartTotal * 0.05m;
    decimal aidenCut = cartTotal * 0.50m;
    decimal grandTotal = cartTotal + tax + aidenCut;
}

<div class="row">
    <div class="col-12 col-md-7 col-lg-8">
        <div class="card shadow-sm mb-3 mb-md-0">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0">Cart</h1>
                </div>
            </div>
            <div class="card-body d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-striped align-middle music-table music-table-list music-table-list-cart">
                        <colgroup>
                            <col class="col-picture" />
                            <col class="col-primary" />
                            <col class="col-price" />
                            <col class="col-actions" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th colspan="2">Item</th>
                                <th class="text-center">Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cart)
                            {
                                <tr>
                                    <td class="position-relative">
                                        <img class="img-fluid" src="@item.Picture" alt="@item.Title" loading="lazy" width="75" height="75" />
                                    </td>
                                    <td class="position-relative">
                                        <div class="text-reset music-primary-text">@Truncate(item.Title, 40)</div>
                                        <div class="text-reset music-secondary-text">@Truncate(item.Artist, 40)</div>
                                    </td>
                                    <td class="text-center position-relative">
                                        @Html.DisplayFor(modelItem => item.Price)
                                    </td>
                                    <td class="text-center">
                                        <form method="post">
                                            <button class="btn btn-sm btn-primary" type="submit" asp-page-handler="RemoveFromCart" asp-route-id="@item.Id">
                                                <span class="bi bi-x-lg btn-icon"></span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-body d-md-none">
                <div class="row g-2">
                    @foreach (var item in Model.Cart)
                    {
                        <div class="col-12">
                            <div class="card cart-mobile-item">
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between gap-2">
                                        <div class="d-flex gap-2">
                                            <img class="cart-mobile-img rounded" src="@item.Picture" alt="@item.Title" loading="lazy" width="84" height="84" />
                                            <div>
                                                <div class="music-secondary-text">@Truncate(item.Artist, 32)</div>
                                                <div class="music-primary-text">@Truncate(item.Title, 32)</div>
                                                <div class="mt-2">@Html.DisplayFor(modelItem => item.Price)</div>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <form method="post">
                                                <button class="btn btn-sm btn-primary" type="submit" asp-page-handler="RemoveFromCart" asp-route-id="@item.Id">
                                                    <span class="bi bi-x-lg btn-icon"></span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <div>Order Summary</div>
                    <div class="small text-end">
                        Total Items - @Model.Cart.Count
                    </div>
                </div>
            </div>
            <div class="card-body checkout-font-size">
                <div class="d-none d-md-block">
                    <div class="row mb-0">
                        <div class="col-sm-9" style="font-size: 0.8em">Item</div>
                        <div class="col-sm-3 text-end" style="font-size: 0.8em">Price</div>
                    </div>
                    @foreach (var item in Model.Cart)
                    {
                        <div class="row mb-1">
                            <div class="col-sm-9">@Truncate(item.Artist, 16) - @Truncate(item.Title, 20)</div>
                            <div class="col-sm-3 text-end">@Html.DisplayFor(modelItem => item.Price)</div>
                        </div>
                    }
                    <hr />
                </div>
                <div class="row">
                    <div class="col-sm-9 col-8">Cart Total:</div>
                    <div class="col-sm-3 col-4 text-end">@cartTotal.ToString("C2")</div>
                </div>
                <div class="row">
                    <div class="col-sm-9 col-8">Tax:</div>
                    <div class="col-sm-3 col-4 text-end">@tax.ToString("C2")</div>
                </div>
                <div class="row">
                    <div class="col-sm-9 col-8">Aiden Cut (50%):</div>
                    <div class="col-sm-3 col-4 text-end">@aidenCut.ToString("C2")</div>
                </div>
                <div class="row">
                    <div class="col-sm-9 col-8">Grand Total:</div>
                    <div class="col-sm-3 col-4 text-end" style="font-weight: 600; font-size: 1.2em;">@grandTotal.ToString("C2")</div>
                </div>
            </div>
            <div class="card-footer text-end p-3">
                @if (Model.Cart.Count > 0 && isAuthenticated)
                {
                    <a asp-page="/Checkout" class="btn btn-sm btn-primary">
                        Proceed to Checkout
                    </a>
                }
            </div>
        </div>
    </div>
</div>
            