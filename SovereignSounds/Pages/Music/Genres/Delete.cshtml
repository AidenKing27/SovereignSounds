@page
@model SovereignSounds.Pages.Music.Genres.DeleteModel

@{
    ViewData["Title"] = "Delete Genre";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0">Delete Genre</h1>
                    <a asp-page="./View" class="btn btn-secondary">
                        <span class="bi bi-arrow-return-left me-2"></span>
                        Back to List
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <p class="alert alert-danger mb-4">Are you sure you want to permanently delete this genre?</p>
                <dl class="row mb-0">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Genre.Name)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Genre.Name)</dd>
                </dl>
            </div>
            <div class="card-footer">
                <form method="post" class="d-flex justify-content-end">
                    <input type="hidden" asp-for="Genre.Id" />
                    <button type="submit" class="btn btn-danger">
                        <span class="bi bi-trash me-2"></span>
                        Delete Genre
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
