@page
@using System.Text
@model SovereignSounds.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";

    static string FormatPhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        StringBuilder sb = new();
        sb.Append("(");
        sb.Append(value.Substring(0, 3));
        sb.Append(") ");
        sb.Append(value.Substring(3, 3));
        sb.Append("-");
        sb.Append(value.Substring(6, 4));

        return sb.ToString();
    }
}

<div class="row">
    <div class="col-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0">Profile</h1>
                </div>
            </div>
            <div class="card-body">
                <p class="mb-4">Welcome to your profile page. You can manage your account details and security settings.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">First Name</dt>
                    <dd class="col-sm-8">@(Model.Customer?.FirstName ?? "")</dd>

                    <dt class="col-sm-4">Last Name</dt>
                    <dd class="col-sm-8">@(Model.Customer?.LastName ?? "")</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(Model.Customer?.IdentityUser.Email ?? "")</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(@FormatPhone(Model.Customer?.IdentityUser.PhoneNumber) ?? "")</dd>
                </dl>

                <div class="text-end">
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Profile">
                        View Account Settings
                    </a>
                </div>
            </div>
            <div class="card-footer">
            </div>
        </div>
    </div>
    <div class="col-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0">Library</h1>
                </div>
            </div>
            <div class="card-body">
                <p class="mb-4">Use this section to view all the songs and albums you own.</p>

                <div class="row g-4">

                    <div class="col-12 col-md-6">
                        <h3 class="h6 mb-3">Songs</h3>
                        <ul class="list-group list-group-flush">
                            @foreach (var song in Model.CustomerSongs)
                            {
                                <li class="list-group-item text-muted px-0">@song.Artist - @song.Title</li>
                            }
                        </ul>
                    </div>

                    <div class="col-12 col-md-6">
                        <h3 class="h6 mb-3">Albums</h3>
                        <ul class="list-group list-group-flush">
                            @foreach (var album in Model.CustomerAlbums)
                            {
                                <li class="list-group-item text-muted px-0">@album.Artist - @album.Title</li>
                            }
                        </ul>
                    </div>

                </div>
            </div>
            <div class="card-footer">
            </div>
        </div>
    </div>
</div>
