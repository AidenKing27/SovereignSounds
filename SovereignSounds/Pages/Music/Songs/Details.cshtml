@page
@model SovereignSounds.Pages.Music.Songs.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Song</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.Album)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Song.Album.Artist)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.Duration)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Song.Duration)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Song.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.Artist)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Song.Artist)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.ReleaseDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Song.ReleaseDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Song.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Song.Picture)
        </dt>
        <dd class="col-sm-10">
            <img class="img-fluid" src="@Model.Song.Picture" alt="@Model.Song.Title" width="460" height="345" />
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Song.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
