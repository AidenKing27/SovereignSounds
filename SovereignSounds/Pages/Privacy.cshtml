@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}
<h1 class="mb-3 py-1">@ViewData["Title"]</h1>

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Overview</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Sovereign Sounds respects your privacy and is committed to protecting your personal information.
                    This page explains what information is collected, how it is used, and the choices available to you.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Information We Collect</h2>
            </div>
            <div class="card-body">
                <p>
                    We may collect information you provide directly, including:
                </p>
                <ul class="mb-0">
                    <li>Account details such as name, email address, and login information.</li>
                    <li>Profile information you choose to add.</li>
                    <li>Purchase and order details needed to process transactions.</li>
                    <li>Support messages and other communications sent to us.</li>
                </ul>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">How We Use Information</h2>
            </div>
            <div class="card-body">
                <p>Your information is used to operate and improve the platform, including to:</p>
                <ul class="mb-0">
                    <li>Create and manage your account.</li>
                    <li>Process purchases and deliver order confirmations.</li>
                    <li>Provide customer support and respond to requests.</li>
                    <li>Maintain service security and prevent fraud or misuse.</li>
                    <li>Improve site features and overall user experience.</li>
                </ul>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Cookies and Usage Data</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Sovereign Sounds may use cookies and similar technologies to remember preferences, keep you signed in,
                    and understand how the site is used. You can adjust cookie settings in your browser.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Sharing of Information</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    We do not sell personal information. Information may be shared only when necessary to run the service,
                    such as with payment processors or hosting providers, or when required by law.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Data Retention and Security</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    We retain data only as long as needed for legitimate business and legal purposes.
                    Reasonable administrative, technical, and physical safeguards are used to protect stored information.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Your Choices</h2>
            </div>
            <div class="card-body">
                <p>You may have the ability to:</p>
                <ul class="mb-0">
                    <li>Review and update account information.</li>
                    <li>Request account deletion, subject to legal obligations.</li>
                    <li>Contact us with questions about your personal data.</li>
                </ul>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>
</div>
