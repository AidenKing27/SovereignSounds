@page
@model SovereignSounds.Pages.Music.Albums.ViewModel
@{
    ViewData["Title"] = "Albums";
    bool isAdmin = User.IsInRole("Admin");

    static string Truncate(string? value, int maxLength = 20)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return value.Length <= maxLength
            ? value
            : $"{value[..maxLength]}…";
    }
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h1 class="mb-0">Albums</h1>
                        <form method="post" asp-page-handler="SetListStyle">
                            <input type="hidden" name="search" value="@Model.Search" />
                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" name="style" id="gridStyle"
                                       value="@ListStyle.Grid.ToString()"
                                @(Model.ListStyle == ListStyle.Grid ? "checked" : "")
                                       onchange="this.form.submit()" autocomplete="off">
                                <label class="btn btn-toggle" for="gridStyle">
                                    <span class="bi bi-grid-3x3-gap-fill btn-icon"></span>
                                </label>

                                <input type="radio" class="btn-check" name="style" id="listStyle"
                                       value="@ListStyle.List.ToString()"
                                @(Model.ListStyle == ListStyle.List ? "checked" : "")
                                       onchange="this.form.submit()" autocomplete="off">
                                <label class="btn btn-toggle" for="listStyle">
                                    <span class="bi bi-list-ul btn-icon"></span>
                                </label>

                                <input type="radio" class="btn-check" name="style" id="compactStyle"
                                       value="@ListStyle.Compact.ToString()"
                                @(Model.ListStyle == ListStyle.Compact ? "checked" : "")
                                       onchange="this.form.submit()" autocomplete="off">
                                <label class="btn btn-toggle" for="compactStyle">
                                    <span class="bi bi-list-columns-reverse btn-icon"></span>
                                </label>
                            </div>
                        </form>
                        <form method="get" class="align-items-center gap-2 d-md-flex d-none">
                            <input type="hidden" name="style" value="@Model.ListStyle" />
                            <input type="hidden" name="pageNumber" value="1" />
                            <input class="form-control w-auto" name="search" value="@Model.Search" type="text" placeholder="Search..." aria-label="Search">
                            <button class="btn btn-outline-primary" type="submit">Search</button>
                        </form>
                    </div>
                    @if (isAdmin)
                    {
                        <a asp-page="Create" class="btn btn-primary">
                            <span class="bi bi-plus-lg btn-icon"></span>
                            Create New
                        </a>
                    }
                </div>
                <form method="get" class="gap-2 d-md-none d-flex">
                    <input type="hidden" name="style" value="@Model.ListStyle" />
                    <input type="hidden" name="pageNumber" value="1" />
                    <input class="form-control" name="search" value="@Model.Search" type="text" placeholder="Search..." aria-label="Search">
                    <button class="btn btn-outline-primary" type="submit">Search</button>
                </form>
            </div>
            <div class="card-body">
                @switch (Model.ListStyle)
                {
                    case ListStyle.Grid:
                        <div class="row g-3">
                            @foreach (var item in Model.Albums)
                            {
                                <div class="col-xxl-4 col-lg-4 col-sm-6 col-12 d-flex justify-content-center">
                                    <div class="position-relative">
                                        <div class="price-badge">
                                            @Html.DisplayFor(modelItem => item.Price)
                                        </div>
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="text-reset text-decoration-none d-block">
                                            <div class="card-custom text-center" role="button" style="cursor: pointer;">
                                                <img src="@item.Picture" alt="@item.Title" loading="lazy" class="music-cover rounded" />
                                                <div class="pt-2 pb-2">
                                                    <span class="music-primary-text">@Html.DisplayFor(modelItem => item.Title)</span> - <span class="music-secondary-text music-secondary-text-grid">@Html.DisplayFor(modelItem => item.Artist)</span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                        break;

                    case ListStyle.List:
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle music-table music-table-list music-table-list-albums">
                                <colgroup>
                                    <col class="col-picture" />   @* Picture *@
                                    <col class="col-primary" />   @* Album *@
                                    <col class="col-secondary hide-below-md" />   @* ReleaseDate *@
                                    <col class="col-tertiary hide-below-md" />   @* Duration *@
                                    <col class="col-price" />   @* Price *@
                                    <col class="col-actions" />   @* Actions *@
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th colspan="2">Album</th>
                                        <th class="hide-below-md">Release Date</th>
                                        <th class="hide-below-md">Duration</th>
                                        <th class="text-center">Price</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Albums)
                                    {
                                        <tr>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    <img class="img-fluid rounded" src="@item.Picture" alt="@item.Title" loading="lazy" width="75" height="75" />
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    <div class="text-reset music-primary-text">@Truncate(item.Title, 40)</div>
                                                    <div class="text-reset music-secondary-text">@Truncate(item.Artist, 40)</div>
                                                </a>
                                            </td>
                                            <td class="position-relative hide-below-md">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.ReleaseDateDisplay)
                                                </a>
                                            </td>
                                            <td class="position-relative hide-below-md">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.DurationDisplay)
                                                </a>
                                            </td>
                                            @if (!isAdmin && Model.OwnedAlbumIds.Contains(item.Id))
                                            {
                                                <td colspan="2" class="text-center position-relative">
                                                    <div class="owned-chip">
                                                        Owned
                                                    </div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="text-center position-relative">
                                                    <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                        @Html.DisplayFor(modelItem => item.Price)
                                                    </a>
                                                </td>
                                                <td class="text-center">
                                                    @if (isAdmin)
                                                    {
                                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                                            <span class="bi bi-trash"></span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-page="/ShoppingCart" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                                            <span class="bi bi-cart4 btn-icon"></span>
                                                        </a>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case ListStyle.Compact:
                        <div class="table-responsive">
                            <table class="table table-striped table-sm table-hover align-middle music-table music-table-compact music-table-compact-albums">
                                <colgroup>
                                    <col class="col-primary" />  @* Title *@
                                    <col class="col-secondary" />  @* Artist *@
                                    <col class="col-tertiary hide-below-md" />  @* ReleaseDate *@
                                    <col class="col-quaternary hide-below-sm" />  @* Duration *@
                                    <col class="col-price" />  @* Price *@
                                    <col class="col-actions" />  @* Actions *@
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th class="">Title</th>
                                        <th class="">Artist</th>
                                        <th class="hide-below-md">Release Date</th>
                                        <th class="text-center hide-below-sm">Duration</th>
                                        <th class="text-center">Price</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Albums)
                                    {
                                        <tr>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.Title)
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.Artist)
                                                </a>
                                            </td>
                                            <td class="position-relative hide-below-md">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.ReleaseDateDisplay)
                                                </a>
                                            </td>
                                            <td class="text-center position-relative hide-below-sm">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.DurationDisplay)
                                                </a>
                                            </td>
                                            @if (!isAdmin && Model.OwnedAlbumIds.Contains(item.Id))
                                            {
                                                <td colspan="2" class="text-center position-relative">
                                                    <div class="owned-chip">
                                                        Owned
                                                    </div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="text-center position-relative">
                                                    <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                        @Html.DisplayFor(modelItem => item.Price)
                                                    </a>
                                                </td>
                                                <td class="text-center">
                                                    @if (isAdmin)
                                                    {
                                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                                            <span class="bi bi-trash"></span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-page="/ShoppingCart" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                                            <span class="bi bi-cart4 btn-icon"></span>
                                                        </a>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;
                }
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="small">
                    Page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems items)
                </div>

                @if (Model.TotalPages > 1)
                {
                    Dictionary<string, string> SendVariables(int pageNumber) => new()
                    {
                        ["style"] = Model.ListStyle.ToString(),
                        ["search"] = Model.Search ?? string.Empty,
                        ["pageNumber"] = pageNumber.ToString()
                    };

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @* First *@
                            <li class="page-item">
                                <a class="page-link" asp-page="./View" asp-all-route-data="@(SendVariables(1))">
                                    <span class="bi bi-chevron-double-left btn-icon"></span>
                                </a>
                            </li>
                            @* Prev *@
                            <li class="page-item">
                                <a class="page-link" asp-page="./View" asp-all-route-data="@(SendVariables(Model.PageNumber - 1))">
                                    <span class="bi bi-chevron-left btn-icon"></span>
                                </a>
                            </li>
                            @* Next *@
                            <li class="page-item">
                                <a class="page-link" asp-page="./View" asp-all-route-data="@(SendVariables(Model.PageNumber + 1))">
                                    <span class="bi bi-chevron-right btn-icon"></span>
                                </a>
                            </li>
                            @* Last *@
                            <li class="page-item">
                                <a class="page-link" asp-page="./View" asp-all-route-data="@(SendVariables(Model.TotalPages))">
                                    <span class="bi bi-chevron-double-right btn-icon"></span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>

</div>

