@page
@using SovereignSounds.Models
@model SovereignSounds.Pages.Music.Songs.ViewModel
@{
    ViewData["Title"] = "Songs";
    var isAdmin = User.IsInRole("Admin");

    static string Truncate(string? value, int maxLength = 20)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Length <= maxLength
            ? value
            : $"{value[..maxLength]}…";
    }
}

<div class="row">

    <div class="col-lg-2 col-12 mb-lg-3 mb-1 d-lg-block d-none">
        <h1 class="mb-lg-3">Songs</h1>

        <div class="card shadow">
            <div class="card-header">
                Filters
            </div>
            <div class="card-body">
            </div>
        </div>
    </div>

    <div class="col-lg-10 col-12">
        <div class="card shadow">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h1 class="mb-0 d-lg-none d-block">Songs</h1>
                        <form method="post" asp-page-handler="SetListStyle">
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" name="style" id="gridStyle"
                                       value="@ListStyle.Grid.ToString()"
                                @(Model.ListStyle == ListStyle.Grid ? "checked" : "")
                                       onchange="this.form.submit()" autocomplete="off">
                                <label class="btn btn-toggle" for="gridStyle">
                                    <span class="bi bi-grid-3x3-gap-fill btn-icon"></span>
                                </label>

                                <input type="radio" class="btn-check" name="style" id="listStyle"
                                       value="@ListStyle.List.ToString()"
                                @(Model.ListStyle == ListStyle.List ? "checked" : "")
                                       onchange="this.form.submit()" autocomplete="off">
                                <label class="btn btn-toggle" for="listStyle">
                                    <span class="bi bi-list-ul btn-icon"></span>
                                </label>

                                <input type="radio" class="btn-check" name="style" id="compactStyle"
                                       value="@ListStyle.Compact.ToString()"
                                @(Model.ListStyle == ListStyle.Compact ? "checked" : "")
                                       onchange="this.form.submit()" autocomplete="off">
                                <label class="btn btn-toggle" for="compactStyle">
                                    <span class="bi bi-list-columns-reverse btn-icon"></span>
                                </label>
                            </div>
                        </form>
                        <form method="get" class="d-flex align-items-center gap-2">
                            <input class="form-control w-auto" name="search" value="@Model.Search" type="text" placeholder="Search..." aria-label="Search">
                            <button class="btn btn-outline-primary" type="submit">Search</button>
                        </form>
                    </div>
                    @if (isAdmin)
                    {
                        <a asp-page="Create" class="btn btn-primary">
                            <span class="bi bi-plus-lg btn-icon"></span>
                            Create New
                        </a>
                    }
                </div>
            </div>
            <div class="card-body">
                @switch (Model.ListStyle)
                {
                    case ListStyle.Grid:
                        <div class="row g-3">
                            @foreach (var item in Model.Songs)
                            {
                                <div class="col-xxl-4 col-lg-6 col-12 d-flex justify-content-center">
                                    <div class="song-grid-card position-relative">
                                        <div class="price-badge price-highlight">
                                            @Html.DisplayFor(modelItem => item.Price)
                                        </div>
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="text-reset text-decoration-none d-block">
                                            <div class="card-custom text-center" role="button" style="cursor: pointer;">
                                                <img src="@item.Picture" alt="@item.Title" loading="lazy" />
                                                <div class="pt-2 pb-2">
                                                    <span style="font-weight: 600; font-size: 1.1em">@Html.DisplayFor(modelItem => item.Title)</span> - <span style="font-weight: inherit; opacity: 0.75">@Html.DisplayFor(modelItem => item.Artist)</span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                        break;

                    case ListStyle.List:
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle music-list-table">
                                @if (isAdmin)
                                {
                                    <colgroup>
                                        <col style="width: 10%;" />  @* Picture *@
                                        <col style="width: 24%;" />  @* Song *@
                                        <col style="width: 20%;" />  @* Album *@
                                        <col style="width: 8%;" />   @* Duration *@
                                        <col style="width: 8%;" />   @* Price *@
                                        <col style="width: 10%;" />  @* Actions *@
                                    </colgroup>
                                }
                                else
                                {
                                    <colgroup>
                                        <col style="width: 8%;" />  @* Picture *@
                                        <col style="width: 37%;" />  @* Song *@
                                        <col style="width: 25%;" />  @* Album *@
                                        <col style="width: 20%;" />   @* Duration *@
                                        <col style="width: 10%;" />   @* Price *@
                                    </colgroup>
                                }
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>
                                            Song
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Songs[0].Artist)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.Songs[0].Duration)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.Songs[0].Price)
                                        </th>
                                        @if (isAdmin)
                                        {
                                            <th></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Songs)
                                    {
                                        <tr>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    <img class="img-fluid" src="@item.Picture" alt="@item.Title" loading="lazy" width="75" height="75" />
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    <div class="text-reset" style="font-weight: 600; font-size: 1.1em">@Truncate(item.Title, 40)</div>
                                                    <div class="text-reset" style="font-weight: inherit; opacity: 0.6">@Truncate(item.Album.Title, 40)</div>
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Truncate(item.Artist, 30)
                                                </a>
                                            </td>
                                            <td class="text-center position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.DurationDisplay)
                                                </a>
                                            </td>
                                            <td class="text-center position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none price-highlight">
                                                    @Html.DisplayFor(modelItem => item.Price)
                                                </a>
                                            </td>
                                            @if (isAdmin)
                                            {
                                                <td class="text-center">
                                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                        <span class="bi bi-pencil-square"></span>
                                                    </a>
                                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                                        <span class="bi bi-trash"></span>
                                                    </a>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case ListStyle.Compact:
                        <div class="table-responsive">
                            <table class="table table-striped table-sm table-hover align-middle music-list-table">
                                @if (isAdmin)
                                {
                                    <colgroup>
                                        <col style="width: 22%;" />  @* Title *@
                                        <col style="width: 18%;" />  @* Album *@
                                        <col style="width: 18%;" />  @* Artist *@
                                        <col style="width: 22%;" />  @* ReleaseDate *@
                                        <col style="width: 10%;" />  @* Duration *@
                                        <col style="width: 10%;" />  @* Price *@
                                        <col style="width: 10%;" />  @* Actions *@
                                    </colgroup>
                                }
                                else
                                {
                                    <colgroup>
                                        <col style="width: 25%;" />  @* Title *@
                                        <col style="width: 25%;" />  @* Album *@
                                        <col style="width: 20%;" />  @* Artist *@
                                        <col style="width: 10%;" />  @* ReleaseDate *@
                                        <col style="width: 10%;" />   @* Duration *@
                                        <col style="width: 10%;" />   @* Price *@
                                    </colgroup>
                                }
                                <thead>
                                    <tr>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Songs[0].Title)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Songs[0].Artist)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Songs[0].Album)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Songs[0].ReleaseDate)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.Songs[0].Duration)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.Songs[0].Price)
                                        </th>
                                        @if (isAdmin)
                                        {
                                            <th></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Songs)
                                    {
                                        <tr>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.Title)
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.Artist)
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.Album.Title)
                                                </a>
                                            </td>
                                            <td class="position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.ReleaseDateDisplay)
                                                </a>
                                            </td>
                                            <td class="text-center position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.DurationDisplay)
                                                </a>
                                            </td>
                                            <td class="text-center position-relative">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                                    @Html.DisplayFor(modelItem => item.Price)
                                                </a>
                                            </td>
                                            @if (isAdmin)
                                            {
                                                <td class="text-center">
                                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                        <span class="bi bi-pencil-square"></span>
                                                    </a>
                                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                                        <span class="bi bi-trash"></span>
                                                    </a>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;
                }
            </div>
        </div>
    </div>
</div>

