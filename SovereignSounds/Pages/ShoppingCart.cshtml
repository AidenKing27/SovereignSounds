@page
@using SovereignSounds.Models
@model SovereignSounds.Pages.ShoppingCartModel
@{
    static string Truncate(string? value, int maxLength = 20)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Length <= maxLength
            ? value
            : $"{value[..maxLength]}…";
    }
}

<div class="row">

    <div class="col-lg-2 col-12 mb-lg-3 mb-1 d-lg-block d-none">
        <h1 class="mb-lg-3">Cart</h1>

        <div class="card shadow-sm">
            <div class="card-header">
                Cart Info
            </div>
            <div class="card-body">
            </div>
        </div>
    </div>

    <div class="col-lg-10 col-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap p-2 gap-2">
                    <h1 class="mb-0 d-lg-none d-block">Cart</h1>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle music-table music-table-list music-table-list-songs">
                        <colgroup>
                            <col class="col-picture" />  @* Picture *@
                            <col class="col-primary" />  @* Song *@
                            <col class="col-tertiary hide-below-sm" />   @* Duration *@
                            <col class="col-price" />   @* Price *@
                        </colgroup>
                        <thead>
                            <tr>
                                <th></th>
                                <th>
                                    Song
                                </th>
                                <th class="hide-below-sm">
                                    @Html.DisplayNameFor(model => model.Cart[0].Duration)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Cart[0].Price)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cart)
                            {
                                <tr>
                                    <td class="position-relative">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                            <img class="img-fluid" src="@item.Picture" alt="@item.Title" loading="lazy" width="75" height="75" />
                                        </a>
                                    </td>
                                    <td class="position-relative">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                            <div class="text-reset music-primary-text">@Truncate(item.Title, 40)</div>
                                            <div class="text-reset music-secondary-text">@Truncate(item.Artist, 40)</div>
                                        </a>
                                    </td>
                                    <td class="text-center position-relative hide-below-sm">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none">
                                            @Html.DisplayFor(modelItem => item.Duration)
                                        </a>
                                    </td>
                                    <td class="text-center position-relative">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="stretched-link text-reset text-decoration-none price-highlight">
                                            @Html.DisplayFor(modelItem => item.Price)
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
            </div>
        </div>
    </div>
</div>
            