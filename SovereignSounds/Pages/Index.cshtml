@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center py-5">
    <h1 class="display-3 mb-4">Welcome to Sovereign Sounds</h1>
    <p>Your premier music-store destination for discovering and purchasing your favorite music, full albums, and individual songs.</p>
</div>

<div class="row pb-4">
    <div class="col-12 col-lg-6">
        <div class="card h-100 shadow-sm rounded-4">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Discover New Favorites</h2>
            </div>
            <div class="card-body p-4">
                <p class="mb-0">
                    Explore a growing catalog of songs and albums across multiple genres. From classics to fresh releases,
                    Sovereign Sounds helps you find music that matches every mood.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100 shadow-sm rounded-4">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Build Your Collection</h2>
            </div>
            <div class="card-body p-4">
                <p class="mb-0">
                    Buy full albums or individual tracks, then keep everything organized in your library. Enjoy quick access
                    to your purchased music anytime you return.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card h-100 shadow-sm rounded-4">
            <div class="card-header">
                <h2 class="h4 mb-0 py-1">Coming Soon...</h2>
            </div>
            <div class="card-body p-4">
                <p class="mb-0">
                    30-second music previews so you can sample tracks before purchasing. Quickly discover
                    the sound you love with instant snippets from songs across our catalog.
                </p>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>
</div>